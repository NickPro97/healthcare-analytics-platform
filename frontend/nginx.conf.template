# Template: envsubst fills ${...} at container start.
# Serves the React build and routes /api/* to the right backend service.
# Service host names match docker-compose.yml and the Kubernetes Services.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Values come from environment variables (see Dockerfile defaults / Kubernetes manifest).
    # Resolving at request time lets nginx start even if a backend is not up yet.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $patient      ${PATIENT_UPSTREAM};
    set $analytics    ${ANALYTICS_UPSTREAM};
    set $notification ${NOTIFICATION_UPSTREAM};
    set $assistant    ${ASSISTANT_UPSTREAM};

    location /api/auth/          { proxy_pass $patient; }
    location /api/patients       { proxy_pass $patient; }
    location /api/health         { proxy_pass $patient; }
    location /api/alerts         { proxy_pass $analytics; }
    location /api/analytics/     { proxy_pass $analytics; }
    location /api/assistant/     { proxy_pass $assistant; proxy_read_timeout 120s; }

    # Server-Sent Events: no buffering, long-lived connection
    location /api/notifications/ {
        proxy_pass $notification;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        try_files $uri /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
