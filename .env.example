# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# Shared by every backend service. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# PostgreSQL password for user "nikhil"
DB_PASSWORD=

# Demo login passwords (users: nikhil = ADMIN, clinician = CLINICIAN)
APP_ADMIN_PASSWORD=
APP_CLINICIAN_PASSWORD=

# AI assistant provider: "ollama" (free, local - default) or "openai" (paid)
#   Ollama: install from https://ollama.com, then:  ollama pull llama3.2:3b && ollama pull nomic-embed-text
AI_PROVIDER=ollama
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=

# Folder on YOUR computer that holds the MIMIC-III demo CSV files (read-only mount)
MIMIC_DATA_DIR=/Users/nick/Desktop/patient-health-analytics/data
